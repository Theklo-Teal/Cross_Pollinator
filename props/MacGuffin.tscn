[gd_scene format=3 uid="uid://c1k3fmmludxm3"]

[sub_resource type="GDScript" id="GDScript_h4ctp"]
script/source = "extends TacEntity

func interact_receive(source:TacEntity) -> Error:
	var tween := get_tree().create_tween()
	tween.set_parallel(false)
	if source == null or not $Ball.visible:
		if not $Ball.visible:
			$Label3D.text = \"Relic Removed!\"
		$Label3D.show()
		tween.tween_property($Nest, \"rotation:y\", TAU, 1).from(0)
		tween.tween_callback($Label3D.hide)
	else:
		tween.tween_property($Ball, \"position:y\", 0.8, 1).from(0.15)
		tween.tween_property($Ball, \"position:y\", 0.15, 1).from(0.8)
		tween.tween_callback($Ball.hide)
	tween.play()
	return OK
"

